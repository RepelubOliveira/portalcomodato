# Supabase — projeto portal-comodato (organização Grupo Risel).
# Copie para .env e preencha. O .env nunca é versionado.
#
# Use a chave *publishable* (sb_publishable_...), não a service_role:
# a publishable é pública por natureza e vai para o bundle do navegador de
# qualquer forma — quem protege os dados é a RLS. A service_role ignora
# toda política e não pode entrar no projeto.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
